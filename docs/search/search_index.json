2\u044c \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430. \u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c MkDocs ( mkdocs.yml , \u0442\u0435\u043c\u0430, \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f). \u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0441\u0431\u043e\u0440\u043a\u0443 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 docs . \u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0430\u0439\u0442 \u0447\u0435\u0440\u0435\u0437 GitHub Pages. \u0425\u043e\u0434 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0421\u043e\u0437\u0434\u0430\u043d \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 railmlearning.github.io . \u0418\u043d\u0438\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d MkDocs-\u043f\u0440\u043e\u0435\u043a\u0442 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0435 source . \u041d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0442\u0435\u043c\u0430 dracula \u0438 \u043c\u0435\u043d\u044e \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 nav . \u0421\u043e\u0437\u0434\u0430\u043d\u044b \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b: \u0433\u043b\u0430\u0432\u043d\u0430\u044f, \u043e\u0431 \u0430\u0432\u0442\u043e\u0440\u0435, \u0440\u0430\u0437\u0434\u0435\u043b \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445, \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u21161, \u0448\u0430\u0431\u043b\u043e\u043d \u043e\u0442\u0447\u0451\u0442\u0430. \u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0441\u0431\u043e\u0440\u043a\u0430 \u0441\u0430\u0439\u0442\u0430 \u0432 docs \u0434\u043b\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 GitHub Pages. \u041a\u043e\u0434 \u0438 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f \u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u0441\u0431\u043e\u0440\u043a\u0438: mkdocs build -d ../docs \u0424\u0440\u0430\u0433\u043c\u0435\u043d\u0442 mkdocs.yml : site_name: \u042f\u0433\u043e\u0434\u043d\u044b\u0439 \u0441\u0430\u0432\u0435\u0440\u0435\u043d theme: name: dracula nav: - \u0413\u043b\u0430\u0432\u043d\u0430\u044f: index.md - \u041e\u0431 \u0430\u0432\u0442\u043e\u0440\u0435: about.md - \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b: labs.md - \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u21161: lab1.md - \u0428\u0430\u0431\u043b\u043e\u043d \u043e\u0442\u0447\u0451\u0442\u0430: lab-template.md - \u041e\u0442\u0447\u0451\u0442 \u043f\u043e \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u21161 (\u0441\u0441\u044b\u043b\u043a\u0438): lab1-report.md \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0421\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d \u0438 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0430\u0439\u0442-\u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e \u043d\u0430 GitHub Pages. \u0420\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439: https://github.com/railmlearning/railmlearning.github.io \u0421\u0430\u0439\u0442: https://railmlearning.github.io/labs/lab1/ \u0412\u044b\u0432\u043e\u0434\u044b \u0412 \u0445\u043e\u0434\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0441\u0432\u043e\u0435\u043d\u044b \u0431\u0430\u0437\u043e\u0432\u044b\u0435 \u044d\u0442\u0430\u043f\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0430: \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438, \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430 MkDocs \u0438 \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044b\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 GitHub Pages.","title":"\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u21161"},{"location":"lab1/#no1","text":"","title":"\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u21161"},{"location":"lab1/#_1","text":"\u041e\u0441\u0432\u043e\u0438\u0442\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0430\u0439\u0442\u0430 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c MkDocs \u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e \u043d\u0430 GitHub Pages.","title":"\u0426\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u044b"},{"location":"lab1/#_2","text":"\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430. \u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c MkDocs ( mkdocs.yml , \u0442\u0435\u043c\u0430, \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f). \u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0441\u0431\u043e\u0440\u043a\u0443 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 docs . \u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0430\u0439\u0442 \u0447\u0435\u0440\u0435\u0437 GitHub Pages.","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435"},{"location":"lab1/#_3","text":"\u0421\u043e\u0437\u0434\u0430\u043d \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 railmlearning.github.io . \u0418\u043d\u0438\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d MkDocs-\u043f\u0440\u043e\u0435\u043a\u0442 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0435 source . \u041d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0442\u0435\u043c\u0430 dracula \u0438 \u043c\u0435\u043d\u044e \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 nav . \u0421\u043e\u0437\u0434\u0430\u043d\u044b \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b: \u0433\u043b\u0430\u0432\u043d\u0430\u044f, \u043e\u0431 \u0430\u0432\u0442\u043e\u0440\u0435, \u0440\u0430\u0437\u0434\u0435\u043b \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445, \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u21161, \u0448\u0430\u0431\u043b\u043e\u043d \u043e\u0442\u0447\u0451\u0442\u0430. \u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0441\u0431\u043e\u0440\u043a\u0430 \u0441\u0430\u0439\u0442\u0430 \u0432 docs \u0434\u043b\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 GitHub Pages.","title":"\u0425\u043e\u0434 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f"},{"location":"lab1/#_4","text":"\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u0441\u0431\u043e\u0440\u043a\u0438: mkdocs build -d ../docs \u0424\u0440\u0430\u0433\u043c\u0435\u043d\u0442 mkdocs.yml : site_name: \u042f\u0433\u043e\u0434\u043d\u044b\u0439 \u0441\u0430\u0432\u0435\u0440\u0435\u043d theme: name: dracula nav: - \u0413\u043b\u0430\u0432\u043d\u0430\u044f: index.md - \u041e\u0431 \u0430\u0432\u0442\u043e\u0440\u0435: about.md - \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u